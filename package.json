{
  "name": "maop-ticket-intake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && npm run db:migrate && wrangler dev",
    "dev:api": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "db:migrate": "wrangler d1 migrations apply maop-ticket-intake --local",
    "build:web": "vue-tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "build": "tsc --noEmit && npm run build:web && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && vue-tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vue-tsc": "3.3.14",
    "wrangler": "4.168.0"
  },
  "dependencies": {
    "vue": "3.5.46"
  }
}
