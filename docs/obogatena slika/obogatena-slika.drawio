<mxfile host="app.diagrams.net"><diagram name="Obogatena slika" id="d1"><mxGraphModel dx="1600" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Obravnava zahtevkov v podjetju MAOP&lt;/b&gt;" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=34;" vertex="1" parent="1"><mxGeometry x="300" y="14" width="1000" height="44" as="geometry"/></mxCell><mxCell id="c3" value="obogatena slika sedanjega stanja &amp;middot; zahtevki prispejo s premalo informacijami, obravnava traja predolgo" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=19;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="56" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Podjetje MAOP&lt;/b&gt;&lt;br&gt;32 zaposlenih, 6,99 M € prihodkov (2025)&lt;br&gt;razvoj, uvajanje in podpora IS&lt;br&gt;kupci: podjetja in javni sektor (B2B)&lt;br&gt;orodje za zahtevke: Jira" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;rounded=1;dashed=1;fillColor=#f3f4f6;strokeColor=#666666;fontSize=17;align=left;spacingLeft=14;fillStyle=solid;rotation=-1;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="330" height="145" as="geometry"/></mxCell><mxCell id="c5" value="»Obravnava zahtevkov traja predolgo. Želim manj dodatnih vprašanj in zahtevek takoj v pravem oddelku.«" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;ellipse;shape=cloud;fillColor=#eef5ff;strokeColor=#1d5fa8;strokeWidth=2;fontSize=18;fillStyle=solid;spacingLeft=46;spacingRight=46;spacingTop=22;spacingBottom=18;rotation=-0.5;" vertex="1" parent="1"><mxGeometry x="360" y="88" width="400" height="190" as="geometry"/></mxCell><mxCell id="c6" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;ellipse;fillColor=#eef5ff;strokeColor=#1d5fa8;strokeWidth=2;fillStyle=solid;" vertex="1" parent="1"><mxGeometry x="750" y="202" width="16" height="16" as="geometry"/></mxCell><mxCell id="c7" value="" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;ellipse;fillColor=#eef5ff;strokeColor=#1d5fa8;strokeWidth=2;fillStyle=solid;" vertex="1" parent="1"><mxGeometry x="770" y="185" width="10" height="10" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Pavel Ilija&lt;/b&gt;&lt;br&gt;delni lastnik, naročnik" style="sketch=1;hachureGap=4;jiggle=2;curveFitting=1;disableMultiStroke=0;fontFamily=Patrick Hand;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPatrick%2BHand;html=1;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;strokeWidth=2.5;fillColor=#ffffff;strokeColor=#222222;fontSize=19;opacity=100;textOpacity=100;whiteSpace=nowrap;rotation=-1.0;" vertex="1" parent="1"><mxGeometry x="785" y="140" width="46" height="140" as="geometry"/></mxCell><mxCell id="c9" value="" s